<Window x:Class="AgentTestCat.Views.SetupWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AgentTest · 首次配置"
        Height="520" Width="480"
        MinHeight="460" MinWidth="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#F5F3F0">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#3A3632"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="BorderBrush" Value="#C8C0B8"/>
            <Setter Property="Background" Value="White"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="欢迎使用 AgentTest 小猫" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <TextBlock TextWrapping="Wrap" Foreground="#6A6560">
                填写 API Key 后，将自动写入本机 config/app.yaml、启动 Agent 内核并打开桌宠。
            </TextBlock>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="基本功能（必填）" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"/>
                <TextBlock Text="DeepSeek API Key — 主链对话、计划编排、Memory/Soul 等" TextWrapping="Wrap" Foreground="#6A6560" Margin="0,0,0,6"/>
                <PasswordBox x:Name="DeepSeekKeyBox"/>

                <TextBlock Text="扩展多模态（选填）" FontWeight="SemiBold" FontSize="13" Margin="0,8,0,6"/>
                <TextBlock Text="阿里云 DashScope API Key — OCR / 视觉 / 联网搜索 / TTS 等" TextWrapping="Wrap" Foreground="#6A6560" Margin="0,0,0,6"/>
                <PasswordBox x:Name="DashScopeKeyBox"/>

                <TextBlock Text="WebUI 登录密码（选填）" FontWeight="SemiBold" FontSize="13" Margin="0,8,0,6"/>
                <TextBlock Text="小猫连接 WebUI 使用；留空则保持 config/app.yaml 中现有密码" TextWrapping="Wrap" Foreground="#6A6560" Margin="0,0,0,6"/>
                <PasswordBox x:Name="WebPasswordBox"/>
            </StackPanel>
        </ScrollViewer>

        <TextBlock x:Name="StatusText" Grid.Row="2" Margin="0,12,0,12" TextWrapping="Wrap" Foreground="#8A4540"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="退出" Width="88" Margin="0,0,10,0" Click="ExitButton_Click"/>
            <Button x:Name="StartButton" Content="保存并启动" MinWidth="120" Click="StartButton_Click"
                    Background="#4A6FA5" Foreground="White" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
