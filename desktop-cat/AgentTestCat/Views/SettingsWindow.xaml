<Window x:Class="AgentTestCat.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AgentTest Cat · 设置"
        Height="520" Width="440"
        MinHeight="480" MinWidth="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#F5F3F0">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#3A3632"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="BorderBrush" Value="#C8C0B8"/>
            <Setter Property="Background" Value="White"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="BorderBrush" Value="#C8C0B8"/>
            <Setter Property="Background" Value="White"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="连接 AgentTest" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <TextBlock Text="小猫启动时会自动拉起本机 AgentTest 内核。此处可修改 WebUI 地址与登录信息。" 
                       TextWrapping="Wrap" Foreground="#6A6560" Margin="0"/>
        </StackPanel>

        <!-- 可滚动表单 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="服务地址" FontWeight="SemiBold"/>
                <TextBox x:Name="BaseUrlBox" ToolTip="例如 http://127.0.0.1:8765"/>

                <TextBlock Text="账号" FontWeight="SemiBold"/>
                <TextBox x:Name="UsernameBox"/>

                <TextBlock Text="密码" FontWeight="SemiBold"/>
                <PasswordBox x:Name="PasswordBox"/>

                <TextBlock Text="设备 ID（desktop 通道，Interaction Router）" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBox x:Name="DeviceIdBox"/>

                <CheckBox x:Name="RememberPasswordBox" Content="记住密码（仅存本机 settings.json）" 
                          Margin="0,4,0,8" Foreground="#3A3632"/>
                <CheckBox x:Name="DebugBox" Content="写入调试日志（%AppData%\AgentTestPCAPPCat\debug.log）" 
                          Margin="0,0,0,4" Foreground="#3A3632"/>
                <CheckBox x:Name="EnableSoundBox" Content="提示音（喵叫、回复通知）"
                          IsChecked="True" Margin="0,0,0,4" Foreground="#3A3632"/>
                <CheckBox x:Name="EnableReplyNotifyBox" Content="回复完成通知（窗口隐藏或失焦时托盘气泡）"
                          IsChecked="True" Margin="0,0,0,4" Foreground="#3A3632"/>
                <CheckBox x:Name="OpenWebUiOnStartupBox" Content="启动时打开浏览器并登录 WebUI"
                          IsChecked="True" Margin="0,0,0,4" Foreground="#3A3632"/>

                <TextBlock Text="默认账号一般为 admin，密码见 AgentTest 配置 / WebUI 启动日志。"
                           TextWrapping="Wrap" Foreground="#8A8580" FontSize="11" Margin="0,8,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <!-- 连接状态 -->
        <Border Grid.Row="2" Margin="0,12,0,12" Padding="10,8" CornerRadius="6" Background="#E8E4DE" BorderBrush="#D0C8C0" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="#B0A8A0" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="StatusText" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="#3A3632"/>
            </StackPanel>
        </Border>

        <!-- 按钮 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="DisconnectButton" Content="断开" Width="88" Margin="0,0,8,0" Click="DisconnectButton_Click"/>
            <Button x:Name="ConnectButton" Content="保存并连接" MinWidth="110" Click="ConnectButton_Click"
                    Background="#4A6FA5" Foreground="White" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
