<Window x:Class="AgentTestCat.Views.PetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="AgentTest Cat"
        Width="280" Height="400"
        MinWidth="260" MinHeight="360"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        WindowStartupLocation="Manual"
        AllowDrop="True"
        PreviewDragOver="FileDrop_PreviewDragOver"
        PreviewDrop="FileDrop_PreviewDrop"
        PreviewDragLeave="FileDrop_PreviewDragLeave"
        PreviewMouseMove="WindowRoot_MouseMove"
        PreviewMouseLeftButtonUp="WindowRoot_MouseLeftButtonUp">

    <Window.Resources>
        <Style x:Key="CornerExpandButton" TargetType="Button">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ToolTip" Value="展开全文" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="#66444050" CornerRadius="0,0,6,0">
                            <Path Data="M 2,2 L 14,2 L 2,14 Z" Fill="#D8CFC4" Stretch="Uniform" Margin="2" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RoundIconButton" TargetType="Button">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="#CC444050" />
            <Setter Property="Foreground" Value="#EEE" />
            <Setter Property="BorderBrush" Value="#99888070" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="WindowRoot">
        <Border x:Name="DropRootBorder" Background="Transparent" Padding="4"
                AllowDrop="True"
                PreviewDragOver="FileDrop_PreviewDragOver"
                PreviewDrop="FileDrop_PreviewDrop"
                PreviewDragLeave="FileDrop_PreviewDragLeave">
            <Grid x:Name="RootGrid" Width="260">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 连接状态 -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="2,0,2,4" VerticalAlignment="Center">
                    <Ellipse x:Name="ConnectionStatusDot"
                             Width="8" Height="8"
                             Fill="#807870"
                             VerticalAlignment="Center"
                             Margin="2,0,6,0"
                             ToolTip="连接状态" />
                    <TextBlock x:Name="ConnectionStatusText"
                               Text="未连接"
                               FontSize="10"
                               Foreground="#A8A4A0"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <!-- 历史对话（小猫上方） -->
                <Border x:Name="HistoryPanel"
                        Grid.Row="1"
                        Margin="0,0,0,6"
                        MinHeight="72" MaxHeight="120"
                        CornerRadius="8"
                        Background="#E82A2834"
                        BorderBrush="#B4B4A596"
                        BorderThickness="1"
                        Padding="6,4">
                    <Grid>
                        <Button x:Name="ExpandButton"
                                Style="{StaticResource CornerExpandButton}"
                                HorizontalAlignment="Left" VerticalAlignment="Top"
                                Margin="-6,-4,0,0"
                                Visibility="Collapsed"
                                Click="ExpandButton_Click" />
                        <ScrollViewer x:Name="HistoryScroll"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Margin="8,0,0,0">
                            <ItemsControl x:Name="HistoryList" />
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- 小猫 + 设置/退出 -->
                <Grid Grid.Row="2" Height="140" Margin="0,0,0,6">
                    <Button x:Name="GearButton"
                            Style="{StaticResource RoundIconButton}"
                            HorizontalAlignment="Left" VerticalAlignment="Top"
                            Margin="28,8,0,0"
                            Content="⚙" ToolTip="设置"
                            Click="GearButton_Click" Panel.ZIndex="5" />
                    <Button x:Name="ExitButton"
                            Style="{StaticResource RoundIconButton}"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="0,8,28,0"
                            Content="✕" ToolTip="退出"
                            Click="ExitButton_Click" Panel.ZIndex="5" />

                    <Canvas x:Name="CatFxCanvas"
                            Width="128" Height="128"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            IsHitTestVisible="False"
                            Panel.ZIndex="2" />

                    <Border x:Name="CatQuipBubble"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            Margin="0,0,0,0"
                            Padding="8,4"
                            CornerRadius="8"
                            Background="#E82A2834"
                            BorderBrush="#B4B4A596"
                            BorderThickness="1"
                            Visibility="Collapsed"
                            Panel.ZIndex="6"
                            MaxWidth="200">
                        <TextBlock x:Name="CatQuipText"
                                   TextWrapping="Wrap"
                                   FontSize="11"
                                   Foreground="#F0EEEB"
                                   TextAlignment="Center" />
                    </Border>

                    <Border x:Name="CatDragArea"
                            Width="128" Height="128"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Background="Transparent"
                            Cursor="Hand"
                            Panel.ZIndex="4"
                            MouseLeftButtonDown="CatDragArea_MouseLeftButtonDown"
                            MouseMove="CatDragArea_MouseMove"
                            MouseLeftButtonUp="CatDragArea_MouseLeftButtonUp">
                        <Image x:Name="CatImage"
                               Stretch="Uniform"
                               RenderTransformOrigin="0.5,0.92"
                               RenderOptions.BitmapScalingMode="HighQuality">
                            <Image.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="CatScale" ScaleX="1" ScaleY="1" />
                                    <TranslateTransform x:Name="CatTranslate" X="0" Y="0" />
                                </TransformGroup>
                            </Image.RenderTransform>
                        </Image>
                    </Border>
                </Grid>

                <!-- 附件 chips -->
                <ItemsControl x:Name="AttachChips"
                              Grid.Row="3"
                              Margin="0,0,0,4"
                              Visibility="Collapsed">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <!-- 输入区 -->
                <Grid x:Name="InputArea" Grid.Row="4">
                    <Grid x:Name="InputRow">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="AttachButton"
                                Grid.Column="0"
                                Style="{StaticResource RoundIconButton}"
                                Content="📎" ToolTip="添加附件"
                                Click="AttachButton_Click" Margin="0,0,4,0" />
                        <Button x:Name="ScreenshotButton"
                                Grid.Column="1"
                                Style="{StaticResource RoundIconButton}"
                                Content="📷" ToolTip="框选截图"
                                Click="ScreenshotButton_Click" Margin="0,0,4,0" />
                        <TextBox x:Name="MessageBox"
                                 Grid.Column="2"
                                 AllowDrop="True"
                                 PreviewDragOver="FileDrop_PreviewDragOver"
                                 PreviewDrop="FileDrop_PreviewDrop"
                                 ToolTip="输入消息，或拖入文件/文件夹上传"
                                 Width="120"
                                 MinWidth="120"
                                 MinHeight="28"
                                 Height="28"
                                 MaxHeight="170"
                                 AcceptsReturn="True"
                                 TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto"
                                 VerticalContentAlignment="Top"
                                 FontSize="12"
                                 FontFamily="Segoe UI"
                                 Background="#E8302E3A"
                                 Foreground="#F0EEEB"
                                 BorderBrush="#80787060"
                                 CaretBrush="#F0EEEB"
                                 Padding="6,5"
                                 TextChanged="MessageBox_TextChanged"
                                 PreviewKeyDown="MessageBox_PreviewKeyDown" />
                        <Button x:Name="SendButton"
                                Grid.Column="3"
                                Content="➤"
                                Width="28" Height="28"
                                Margin="4,0,0,0"
                                VerticalAlignment="Bottom"
                                Click="SendButton_Click"
                                Cursor="Hand" />
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <!-- 展开态：浮动可拖动 / 可缩放 -->
        <Border x:Name="BubbleExpanded"
                Visibility="Collapsed"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="8,8,0,0"
                Width="500"
                MinWidth="320"
                MinHeight="240"
                CornerRadius="10"
                Background="#F02A2834"
                BorderBrush="#C0B4A596"
                BorderThickness="1"
                Panel.ZIndex="50">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="180" />
                </Grid.RowDefinitions>

                <Border x:Name="ExpandedHeader"
                        Grid.Row="0"
                        Background="#33484250"
                        CornerRadius="10,10,0,0"
                        Padding="4,4,4,6"
                        Cursor="SizeAll"
                        MouseLeftButtonDown="ExpandedPanel_HeaderMouseDown">
                    <Grid>
                        <TextBlock Text="对话历史（拖动标题栏移动 · 拖边框缩放）"
                                   Margin="22,4,56,2"
                                   Foreground="#A8A4A0"
                                   FontSize="11"
                                   TextWrapping="Wrap" />
                        <Button Style="{StaticResource CornerExpandButton}"
                                HorizontalAlignment="Left" VerticalAlignment="Top"
                                ToolTip="收起"
                                Click="CollapseButton_Click" />
                        <Button x:Name="ClearHistoryButton"
                                Style="{StaticResource RoundIconButton}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Margin="0,0,4,0"
                                Content="🗑"
                                ToolTip="清空历史对话"
                                Click="ClearHistoryButton_Click"
                                Panel.ZIndex="2" />
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Margin="6,0,6,6" ClipToBounds="True">
                    <Border Margin="0,0,8,8" Background="#FF2A2834" CornerRadius="0,0,6,6">
                        <wv2:WebView2 x:Name="MarkdownWebView"
                                      DefaultBackgroundColor="#FF2A2834"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch" />
                    </Border>
                </Grid>

                <!-- 右边框缩放（WebView 右侧留 8px 避免 HWND 遮挡） -->
                <Border x:Name="ResizeRight"
                        Width="8"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Stretch"
                        Background="Transparent"
                        Cursor="SizeWE"
                        MouseLeftButtonDown="ExpandedPanel_ResizeRight" />
                <!-- 下边框缩放 -->
                <Border x:Name="ResizeBottom"
                        Height="8"
                        VerticalAlignment="Bottom"
                        HorizontalAlignment="Stretch"
                        Background="Transparent"
                        Cursor="SizeNS"
                        MouseLeftButtonDown="ExpandedPanel_ResizeBottom" />
                <!-- 右下角缩放 -->
                <Border x:Name="ResizeCorner"
                        Width="14"
                        Height="14"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Background="Transparent"
                        Cursor="SizeNWSE"
                        MouseLeftButtonDown="ExpandedPanel_ResizeCorner" />
            </Grid>
        </Border>
    </Grid>
</Window>
